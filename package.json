{
  "name": "sboptrackingprogram",
  "version": "1.0.0",
  "description": "SBOP Safety Audit and Tracking Web Application with Cloudflare D1 & R2",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "tsx seed.ts",
    "d1:migrate": "wrangler d1 execute d1sbop --local --file=./schema.sql",
    "d1:seed": "wrangler d1 execute d1sbop --local --file=./seed.sql",
    "d1:migrate:remote": "wrangler d1 execute d1sbop --remote --file=./schema.sql",
    "d1:seed:remote": "wrangler d1 execute d1sbop --remote --file=./seed.sql",
    "deploy": "wrangler pages deploy dist"
  },
  "keywords": [
    "sbop",
    "safety",
    "cloudflare-d1",
    "cloudflare-r2",
    "audit"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.784.0",
    "@types/jszip": "^3.4.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
